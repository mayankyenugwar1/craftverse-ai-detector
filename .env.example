# CraftVerse AI Detector Configuration

# API URL for frontend
VITE_API_URL=http://localhost:8000

# Claude API Key (optional - fallback explanation used if not set)
CLAUDE_API_KEY=

# Detection Provider: mock, sightengine, hive
DETECTION_PROVIDER=mock

# Demo Mode: true = use deterministic demo results
DEMO_MODE=true

# Sightengine credentials (required if DETECTION_PROVIDER=sightengine)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Hive credentials (required if DETECTION_PROVIDER=hive)
HIVE_API_KEY=

# File upload limit in bytes (default: 200MB)
MAX_FILE_SIZE=209715200
